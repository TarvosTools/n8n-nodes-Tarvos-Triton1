{
  "name": "Triton Basics - Verify a Transaction",
  "active": false,
  "nodes": [
    {
      "id": "start",
      "name": "Run Manually",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        240
      ],
      "parameters": {}
    },
    {
      "id": "inputs",
      "name": "Your Inputs",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        240
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "signature",
              "name": "signature",
              "type": "string",
              "value": ""
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "read",
      "name": "Read from Triton",
      "type": "n8n-nodes-tarvos-triton-one.tarvosTritonOne",
      "typeVersion": 1.3,
      "position": [
        480,
        240
      ],
      "parameters": {
        "resource": "transaction",
        "operation": "get",
        "signature": "={{ $json.signature }}",
        "showAdvanced": true,
        "transactionEncoding": "jsonParsed"
      },
      "retryOnFail": false
    },
    {
      "id": "result",
      "name": "Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        240
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const r=$input.first().json;const t=r.data;return [{json:t?{found:true,network:r.meta.network,slot:t.slot,succeeded:t.meta.err===null,feeLamports:String(t.meta.fee),instructions:t.transaction.message.instructions,explorer:'https://explorer.solana.com/tx/'+$('Your Inputs').first().json.signature+'?cluster=devnet'}:{found:false,note:'Not found at the requested commitment. Verify network and signature.'}}];"
      }
    },
    {
      "id": "help",
      "name": "Start Here",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -80
      ],
      "parameters": {
        "content": "VERIFY A TRANSACTION. Enter your own transaction signature for the selected network.\n\n1. Open Your Inputs to choose the address or signature.\n2. Select your Devnet Triton credential in Read from Triton.\n3. Execute Workflow, then open Result. This template only reads data; no wallet key is needed.",
        "width": 900,
        "height": 260
      }
    }
  ],
  "connections": {
    "Run Manually": {
      "main": [
        [
          {
            "node": "Your Inputs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Your Inputs": {
      "main": [
        [
          {
            "node": "Read from Triton",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read from Triton": {
      "main": [
        [
          {
            "node": "Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
