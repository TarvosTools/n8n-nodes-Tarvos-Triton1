{
  "name": "Triton Basics - Token Supply",
  "active": false,
  "nodes": [
    {
      "id": "start",
      "name": "Run Manually",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        240
      ],
      "parameters": {}
    },
    {
      "id": "inputs",
      "name": "Your Inputs",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        240
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "mintAddress",
              "name": "mintAddress",
              "type": "string",
              "value": "So11111111111111111111111111111111111111112"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "read",
      "name": "Read from Triton",
      "type": "n8n-nodes-tarvos-triton-one.tarvosTritonOne",
      "typeVersion": 1.3,
      "position": [
        480,
        240
      ],
      "parameters": {
        "resource": "token",
        "operation": "getSupply",
        "address": "={{ $json.mintAddress }}"
      },
      "retryOnFail": false
    },
    {
      "id": "result",
      "name": "Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        240
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const r=$input.first().json;return [{json:{mint:$('Your Inputs').first().json.mintAddress,network:r.meta.network,amount:r.data.value.amount,decimals:r.data.value.decimals,readableSupply:r.data.value.uiAmountString}}];"
      }
    },
    {
      "id": "help",
      "name": "Start Here",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -80
      ],
      "parameters": {
        "content": "READ TOKEN SUPPLY. Enter a token mint, not a wallet address. The wrapped SOL mint is a built-in example; its reported supply has special native-token semantics and is not total SOL supply.\n\n1. Open Your Inputs to choose the address or signature.\n2. Select your Devnet Triton credential in Read from Triton.\n3. Execute Workflow, then open Result. This template only reads data; no wallet key is needed.",
        "width": 900,
        "height": 260
      }
    }
  ],
  "connections": {
    "Run Manually": {
      "main": [
        [
          {
            "node": "Your Inputs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Your Inputs": {
      "main": [
        [
          {
            "node": "Read from Triton",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read from Triton": {
      "main": [
        [
          {
            "node": "Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
