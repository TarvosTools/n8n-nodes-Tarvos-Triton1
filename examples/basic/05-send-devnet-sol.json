    {
      "id": "Verify Result",
      "name": "Verify Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2070,
        220
      ],
      "parameters": {
        "jsCode": "const t=$input.first().json.data;const sent=$('Submit Devnet Transfer').first().json.data.signature;const prepared=$('Prepare Devnet Transfer').first().json;\nif(!t||t.meta?.err!==null)throw Error('Submission already occurred. Transaction not yet verified; check the saved signature before retrying.');\nif(t.transaction.signatures[0]!==sent)throw Error('Transaction signature mismatch');\nconst keys=t.transaction.message.accountKeys.map(k=>typeof k==='string'?k:k.pubkey);const i=keys.indexOf(prepared.recipient);if(i<0)throw Error('Recipient missing from transaction');\nconst delta=BigInt(t.meta.postBalances[i])-BigInt(t.meta.preBalances[i]);if(delta!==BigInt(prepared.lamports))throw Error('This transaction did not credit the expected amount. Do not resend blindly.');\nif(BigInt(t.meta.fee)>10000n)throw Error('Actual fee exceeded test cap');\nreturn [{json:{network:'devnet',status:'PASS',signature:sent,recipient:prepared.recipient,creditedLamports:delta.toString(),recipientTotalLamports:$('Recipient Balance').first().json.data.lamports,feeLamports:String(t.meta.fee),confirmation:$('Confirm Transfer').first().json.data.confirmationStatus,explorer:'https://explorer.solana.com/tx/'+sent+'?cluster=devnet'}}];",
        "mode": "runOnceForAllItems"
      }
    },
